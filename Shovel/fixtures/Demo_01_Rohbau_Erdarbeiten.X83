<GAEB xmlns="http://www.gaeb.de/GAEB_DA_XML/DA83/3.2"><GAEBInfo><Version>3.2</Version><VersDate>2013-10</VersDate><Date>2026-11-21</Date><ProgSystem>Shovel</ProgSystem><ProgName>Shovel 0.1</ProgName></GAEBInfo><PrjInfo><NamePrj>AZ-2026-01</NamePrj><LblPrj>Neubau Ausbildungszentrum mit Werkhalle, Musterstadt</LblPrj><Cur>EUR</Cur><CurLbl>Euro</CurLbl></PrjInfo><Award><DP>83</DP><AwardInfo><Cur>EUR</Cur><CurLbl>Euro</CurLbl></AwardInfo><OWN><Address><Name1>Zweckverband Berufliche Bildung Musterstadt</Name1></Address></OWN><AddText><OutlineAddText><span>Vorbemerkungen</span></OutlineAddText><DetailAddText><p><span>Vorbemerkungen zum Leistungsverzeichnis Erd- und Rohbauarbeiten</span></p><p><span>Gegenstand der Ausschreibung ist der Neubau eines zweigeschossigen Ausbildungszentrums mit angegliederter Werkhalle. Das Gebäude ist nicht unterkellert.</span></p><p><span>Der Ausführung liegen die VOB/B und VOB/C sowie DIN 1045-1 zugrunde.</span></p><p><span>Sämtliche Erschwernisse aus Witterung, beengten Platzverhältnissen und dem laufenden Betrieb der Nachbargebäude sind in die Einheitspreise einzurechnen.</span></p><p><span>Erforderliche Arbeits- und Schutzgerüste werden nicht gesondert vergütet.</span></p><p><span>Maßnahmen der offenen Wasserhaltung sind, soweit erforderlich, in die Einheitspreise einzurechnen.</span></p><p><span>Für die Überschreitung des Fertigstellungstermins wird eine Vertragsstrafe von 0,2 % der Auftragssumme je Werktag vereinbart.</span></p><p><span>Die Baustelle ist über die Werkstraße anzufahren. Lagerflächen stehen nur eingeschränkt zur Verfügung.</span></p></DetailAddText></AddText><BoQ ID="B1"><BoQInfo><Name>AZ-2026-01</Name><LblBoQ>Neubau Ausbildungszentrum mit Werkhalle, Musterstadt</LblBoQ><BoQBkdn><Type>BoQLevel</Type><LblBoQBkdn>Titel</LblBoQBkdn><Length>2</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Item</Type><Length>4</Length><Num>Yes</Num></BoQBkdn><BoQBkdn><Type>Index</Type><Length>1</Length><Num>No</Num></BoQBkdn></BoQInfo><BoQBody><BoQCtgy ID="C01" RNoPart="01"><LblTx><p><span>Baustelleneinrichtung</span></p></LblTx><BoQBody><Itemlist><Item ID="d1" RNoPart="0010"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p><span>Baustelle einrichten für sämtliche in der Leistungsbeschreibung aufgeführten Leistungen. An- und Abtransport der erforderlichen Geräte, Unterkünfte und Lagercontainer.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Baustelle einrichten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d2" RNoPart="0020"><Qty>8.000</Qty><QU>Mt</QU><Description><CompleteText><DetailTxt><Text><p><span>Vorhalten der Baustelleneinrichtung für die Dauer der Rohbauarbeiten.</span></p><p><span>Abrechnung nach Monaten.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Baustelleneinrichtung vorhalten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d3" RNoPart="0030"><Qty>240.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p><span>Bauzaun aus Stahlrohrrahmen mit Gitterfüllung, Höhe 2,00 m, aufstellen, für die Bauzeit vorhalten und wieder abbauen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Bauzaun aufstellen und vorhalten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d4" RNoPart="0040"><LumpSumItem>Yes</LumpSumItem><Qty>1.000</Qty><QU>psch</QU><Description><CompleteText><DetailTxt><Text><p><span>Baustrom und Bauwasser werden bauseits gestellt. Verteilung auf der Baustelle durch den AN.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Baustrom- und Bauwasseranschluss</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="C02" RNoPart="02"><LblTx><p><span>Erdarbeiten</span></p></LblTx><BoQBody><Itemlist><Item ID="d5" RNoPart="0010"><Qty>1850.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p><span>Oberboden in einer Dicke von i. M. 30 cm abtragen und seitlich auf dem Baugrundstück lagern.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Oberboden abtragen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d6" RNoPart="0020"><Qty>2400.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Boden der Baugrube profilgerecht lösen, laden und fördern. Aushubtiefe bis 1,80 m.</span></p><p><span>Bodenklasse 3 bis 5 nach DIN 18300.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Baugrubenaushub</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d7" RNoPart="0030"><Qty>310.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Boden für Einzel- und Streifenfundamente lösen und seitlich lagern. Aushubtiefe bis 1,20 m unter Baugrubensohle, Homogenbereich B1.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Fundamentaushub</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d8" RNoPart="0040"><Qty>3900.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Überschüssigen Aushubboden laden, abfahren und einer Verwertung zuführen, einschl. aller Nebenarbeiten und Gebühren.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Boden abfahren und entsorgen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d9" RNoPart="0050"><Qty>620.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Arbeitsräume mit geeignetem, seitlich gelagertem Boden lagenweise verfüllen und verdichten. Lieferung von Fremdmaterial wird seperat vergütet.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Arbeitsräume verfüllen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d10" RNoPart="0060"><Qty>1850.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p><span>Planum der Baugrubensohle herstellen und verdichten. Verdichtungsgrad und Prüfumfang nach Angabe der Bauleitung.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Planum herstellen und verdichten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d11" RNoPart="0070"><Qty>1850.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p><span>Kapillarbrechende Tragschicht aus Kies 0/32, Dicke 30 cm, liefern, einbauen und verdichten.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Kiestragschicht 30 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d12" RNoPart="0070"><Qty>260.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p><span>Sauberkeitsschicht aus Beton C12/15, Dicke 5 cm, unter Fundamenten herstellen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Sauberkeitsschicht unter Fundamenten</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="C04" RNoPart="04"><LblTx><p><span>Beton- und Stahlbetonarbeiten</span></p></LblTx><BoQBody><Itemlist><Remark ID="R04_0"><Description><CompleteText><DetailTxt><Text><p><span>Sichtbetonflächen sind in Abstimmung mit dem Architekten zu bemustern. Die Schalungsstöße werden noch festgelegt.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Hinweis Sichtbeton</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Remark><Item ID="d13" RNoPart="0010"><Qty>1850.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p><span>Sauberkeitsschicht aus unbewehrtem Beton C12/15, Dicke 5 cm, unter der Bodenplatte herstellen und abziehen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Sauberkeitsschicht C12/15, d = 5 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d14" RNoPart="0020"><Qty>462.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Bodenplatte aus Stahlbeton, Festigkeitsklasse C30/37, Expositionsklasse XC2, als WU-Konstruktion.</span></p><p><span>Dicke: 30 cm.</span></p><p><span>Oberfläche flügelgeglättet. Abrechnung nach m3.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Bodenplatte Stahlbeton C25/30, d = 25 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d15" RNoPart="0030"><Qty>95.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Streifenfundamente aus Stahlbeton herstellen, Querschnitt 60 x 80 cm.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Streifenfundamente Ortbeton</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d16" RNoPart="0040"><Qty>180.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Wände aus Stahlbeton C25/30, XC1, Dicke 24 cm, Höhe bis 3,50 m.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Stahlbetonwände C25/30, d = 24 cm</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d17" RNoPart="0050"><Qty>1.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Stützen aus Stahlbeton C30/37, Querschnitt 40 x 40 cm, Höhe bis 4,20 m.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Stahlbetonstützen C30/37</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d18" RNoPart="0060"><Qty>210.000</Qty><QU>m3</QU><Description><CompleteText><DetailTxt><Text><p><span>Decke über Erdgeschoss aus Stahlbeton C25/30, XC1, Dicke 22 cm.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><s
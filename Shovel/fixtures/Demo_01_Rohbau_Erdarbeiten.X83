ext><DetailTxt><Text><p><span>Fugenblech, beschichtet, in Arbeitsfugen Bodenplatte/Wand einbauen.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Fugenblech Arbeitsfuge</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d25" RNoPart="0130"><Qty>40.000</Qty><QU>St</QU><Description><CompleteText><DetailTxt><Text><p><span>Aussparungen in Wänden und Decken für haustechnische Installationen nach Erfordernis herstellen, Größe bis 0,25 m2.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Aussparungen herstellen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d26" RNoPart="0140"><Qty>96.000</Qty><QU>m</QU><Description><CompleteText><DetailTxt><Text><p><span>Ankerschienen in Wände einbauen.</span></p><p><span>Fabrikat: Ankertec AT-38</span></p></Text><TextComplement Kind="Bidder" MarkLbl="1"><ComplCaption><p><span>Angebotenes Fabrikat:</span></p></ComplCaption><ComplBody><p><span></span></p></ComplBody></TextComplement></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Ankerschienen einbauen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d27" RNoPart="0150"><Provis>WithoutTotal</Provis><Qty>20.000</Qty><QU>St</QU><Description><CompleteText><DetailTxt><Text><p><span>Bedarfsposition: Kernbohrungen in Stahlbeton, Durchmesser bis 150 mm, Bauteildicke bis 30 cm.</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Kernbohrungen</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item><Item ID="d28" RNoPart="0160"><Qty>1850.000</Qty><QU>m2</QU><Description><CompleteText><DetailTxt><Text><p><span>Oberfläche Bodenplatte</span></p></Text></DetailTxt><OutlineText><OutlTxt><TextOutlTxt><p><span>Oberfläche Bodenplatte</span></p></TextOutlTxt></OutlTxt></OutlineText></CompleteText></Description></Item></Itemlist></BoQBody></BoQCtgy><BoQCtgy ID="C05" RNoPa